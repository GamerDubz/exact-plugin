{
  "description": "Keep the Exact checkout fetched and set up on session start",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/exact-bootstrap.sh\" --auto --timeout 90",
            "timeout": 100,
            "statusMessage": "Updating Exact checkout"
          }
        ]
      }
    ]
  }
}
